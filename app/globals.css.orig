@import "tailwindcss";

/* =====================================================
   CSS Variables — Premium Neon Gradient Theme
===================================================== */
:root {
  /* Vibrant neon palette */
  --accent: #00ff88;       /* neon green */
  --accent-2: #00d4ff;     /* cyan */
  --accent-3: #ff006e;     /* hot pink */
  --accent-4: #b537f2;     /* purple */

  --bg-primary: #0a0e27;
  --bg-secondary: #1a1f3a;
  --bg-tertiary: #2d3561;
  --bg-card: rgba(20, 25, 50, 0.5);

  --text-primary: #ffffff;
  --text-secondary: #a0aec0;
  --text-muted: #718096;

  --border-soft: rgba(0, 255, 136, 0.1);
  --border-strong: rgba(0, 212, 255, 0.25);

  --shadow-soft: 0 20px 60px rgba(0, 255, 136, 0.15);
  --font-mono: 'Courier New', 'Consolas', monospace;

  --background: #0a0e27;
  --foreground: #ffffff;
}

/* =====================================================
   Base Reset
===================================================== */
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background:
    linear-gradient(135deg, #0a0e27 0%, #1a0f3a 25%, #0f1a3a 50%, #1a0f2a 75%, #0a0e27 100%);
  background-attachment: fixed;
  color: var(--text-primary);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  overflow-x: hidden;
  line-height: 1.7;
  min-height: 100vh;
  position: relative;
}

body::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background:
    radial-gradient(circle at 20% 50%, rgba(0, 255, 136, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 80% 80%, rgba(0, 212, 255, 0.08) 0%, transparent 50%),
    radial-gradient(circle at 40% 20%, rgba(255, 0, 110, 0.06) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(to bottom, rgba(0, 255, 255, 1), rgba(255, 0, 255, 0.8));
  border-radius: 999px;
  box-shadow: 0 0 20px rgba(0, 255, 255, 0.6);
}

/* =====================================================
   Neon Glow Effects - Holographic
===================================================== */
@keyframes neon-glow {
  0%, 100% {
    text-shadow:
      0 0 10px rgba(0, 255, 255, 0.8),
      0 0 20px rgba(0, 255, 255, 0.5);
  }
  50% {
    text-shadow:
      0 0 20px rgba(0, 255, 255, 1),
      0 0 40px rgba(255, 0, 255, 0.8),
      0 0 60px rgba(0, 255, 0, 0.4);
  }
}

.neon-glow {
  animation: neon-glow 2s ease-in-out infinite;
}

@keyframes gradient-shift {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

.gradient-animate {
  background-size: 200% 200%;
  animation: gradient-shift 6s ease infinite;
}

/* =====================================================
   Premium Glow Utilities
===================================================== */
.premium-text-silver {
  color: var(--accent);
  text-shadow: 0 0 20px rgba(232, 232, 232, 0.15);
}

.premium-text-gold {
  color: var(--accent-2);
  text-shadow: 0 0 20px rgba(212, 175, 55, 0.2);
}

.premium-text-blue {
  color: var(--accent-3);
  text-shadow: 0 0 20px rgba(176, 196, 222, 0.15);
}

.glass-border {
  border: 1px solid var(--border-soft);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.glass-border:hover {
  border-color: var(--border-strong);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 8px 32px rgba(0, 0, 0, 0.3);
}


/* =====================================================
   Holographic Border Animation
===================================================== */
@keyframes border-hologram {
  0%, 100% {
    border-color: rgba(0, 255, 255, 0.3);
    box-shadow: 0 0 30px rgba(0, 255, 255, 0.2), inset 0 0 20px rgba(0, 255, 255, 0.05);
  }
  50% {
    border-color: rgba(255, 0, 255, 0.3);
    box-shadow: 0 0 50px rgba(255, 0, 255, 0.3), inset 0 0 30px rgba(255, 0, 255, 0.1);
  }
}

.premium-border {
  position: relative;
  background: var(--bg-card);
  border-radius: 24px;
  animation: border-hologram 4s ease-in-out infinite;
}

.premium-border::before {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: 26px;
  background: linear-gradient(135deg,
      rgba(0, 255, 255, 0.3),
      rgba(255, 0, 255, 0.2),
      rgba(0, 255, 0, 0.1));
  z-index: -1;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.premium-border:hover::before {
  opacity: 1;
}

/* =====================================================
   Typing Cursor
===================================================== */
@keyframes blink {

  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0;
  }
}

.cursor {
  display: inline-block;
  width: 2px;
  height: 1em;
  background: var(--neon-cyan);
  margin-left: 4px;
  animation: blink 1s step-end infinite;
  vertical-align: middle;
}

/* =====================================================
   Gradient Text - Holographic
===================================================== */
.gradient-text {
  background: linear-gradient(135deg, #00ffff, #ff00ff, #00ff00, #ffff00);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradient-shift 6s ease infinite;
  background-size: 200% 200%;
  filter: drop-shadow(0 0 10px rgba(0, 255, 255, 0.5));
}

.gradient-text-premium {
  background: linear-gradient(135deg, #00ffff, #ff00ff, #00ff00);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* =====================================================
   Floating animation
===================================================== */
@keyframes float {

  0%,
  100% {
    transform: translateY(0px);
  }

  50% {
    transform: translateY(-10px);
  }
}

.float {
  animation: float 4s ease-in-out infinite;
}

/* =====================================================
   Premium Pulse
===================================================== */
@keyframes premium-pulse {
  0%,
  100% {
    box-shadow: 0 0 15px rgba(0, 255, 136, 0.3), 0 0 30px rgba(0, 255, 136, 0.1);
  }
  50% {
    box-shadow: 0 0 30px rgba(0, 255, 136, 0.6), 0 0 60px rgba(0, 212, 255, 0.4);
  }
}

.premium-pulse {
  animation: premium-pulse 2s ease-in-out infinite;
}

/* =====================================================
   Grid background pattern
===================================================== */
.grid-bg {
  background-image:
    linear-gradient(rgba(200, 170, 140, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(200, 170, 140, 0.06) 1px, transparent 1px);
  background-size: 72px 72px;
  mask-image: radial-gradient(circle at center, black 45%, transparent 100%);
  -webkit-mask-image: radial-gradient(circle at center, black 45%, transparent 100%);
}


.prose h2,
.prose h3,
.prose h4 {
  letter-spacing: -0.02em;
}

.prose a {
  text-decoration: none;
  transition: opacity 0.25s ease;
}

.prose a:hover {
  opacity: 0.85;
}

.prose pre {
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18px;
  padding: 1rem 1.1rem;
  overflow-x: auto;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
}

.prose code::before,
.prose code::after {
  content: none;
}

.prose blockquote {
  border-left: 3px solid rgba(212, 175, 55, 0.32);
  background: rgba(212, 175, 55, 0.03);
  padding: 0.9rem 1rem;
  border-radius: 0 14px 14px 0;
}

/* =====================================================
   Reading Progress Bar - Holographic
===================================================== */
#reading-progress {
  position: fixed;
  top: 0;
  left: 0;
  height: 4px;
  background: linear-gradient(to right, #00ffff, #ff00ff, #00ff00, #ffff00);
  z-index: 1000;
  transition: width 0.1s linear;
  box-shadow:
    0 0 30px rgba(0, 255, 255, 0.8),
    0 0 60px rgba(255, 0, 255, 0.5),
    0 0 90px rgba(0, 255, 0, 0.3);
}

/* =====================================================
   Tag pill - Holographic
===================================================== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 0.35rem 0.8rem;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border: 1px solid rgba(0, 255, 255, 0.3);
  color: #00ffff;
  background: rgba(0, 255, 255, 0.1);
  transition: all 0.25s ease;
  cursor: pointer;
  box-shadow: 0 0 15px rgba(0, 255, 255, 0.2);
}

.tag:hover,
.tag.active {
  color: #ffffff;
  background: rgba(0, 255, 255, 0.25);
  border-color: rgba(255, 0, 255, 0.5);
  box-shadow: 0 0 30px rgba(0, 255, 255, 0.5), 0 0 50px rgba(255, 0, 255, 0.3);
}

/* =====================================================
   Masonry grid helper
===================================================== */
.masonry {
  columns: 3;
  column-gap: 1rem;
}

.masonry-item {
  break-inside: avoid;
  margin-bottom: 1rem;
}

@media (max-width: 768px) {
  .masonry {
    columns: 2;
  }
}

@media (max-width: 480px) {
  .masonry {
    columns: 1;
  }
}

/* =====================================================
   Timeline - Holographic
===================================================== */
.timeline-line {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 2px;
  background: linear-gradient(to bottom, #00ffff, #ff00ff, #00ff00, transparent);
  box-shadow: 0 0 20px rgba(0, 255, 255, 0.6);
}

.timeline-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: radial-gradient(circle, #00ffff, #ff00ff);
  box-shadow:
    0 0 20px rgba(0, 255, 255, 1),
    0 0 40px rgba(255, 0, 255, 0.6),
    inset 0 0 10px rgba(255, 255, 255, 0.3);
  position: absolute;
  left: -7px;
  animation: pulse-hologram 2s ease-in-out infinite;
}

@keyframes pulse-hologram {
  0%, 100% {
    box-shadow:
      0 0 20px rgba(0, 255, 255, 1),
      0 0 40px rgba(255, 0, 255, 0.6),
      inset 0 0 10px rgba(255, 255, 255, 0.3);
  }
  50% {
    box-shadow:
      0 0 40px rgba(0, 255, 255, 1),
      0 0 80px rgba(255, 0, 255, 0.8),
      inset 0 0 20px rgba(255, 255, 255, 0.5);
  }
}

/* =====================================================
   Premium Glass Card - Holographic
===================================================== */
.glass-card {
  background: rgba(10, 10, 30, 0.2);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  border: 2px solid rgba(0, 255, 255, 0.2);
  border-radius: 24px;
  box-shadow:
    0 0 40px rgba(0, 255, 255, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.1),
    inset 0 -1px 0 rgba(255, 0, 255, 0.1);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.glass-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.1), transparent);
  animation: hologram-scan 3s infinite;
  pointer-events: none;
}

@keyframes hologram-scan {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}

/* =====================================================
   Holographic Liquid Effects
===================================================== */
@keyframes liquid-morph {
  0%, 100% {
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
  }
  25% {
    border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%;
  }
  50% {
    border-radius: 70% 30% 40% 60% / 30% 60% 60% 40%;
  }
  75% {
    border-radius: 40% 70% 60% 30% / 70% 40% 30% 60%;
  }
}

@keyframes hologram-flicker {
  0%, 100% {
    opacity: 1;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.8), 0 0 20px rgba(255, 0, 255, 0.4);
  }
  50% {
    opacity: 0.95;
    text-shadow: 0 0 20px rgba(0, 255, 255, 1), 0 0 40px rgba(255, 0, 255, 0.6), 0 0 60px rgba(0, 255, 0, 0.3);
  }
}

@keyframes mirror-reflect {
  0%, 100% {
    transform: translateY(0) scaleY(1);
    opacity: 0.3;
  }
  50% {
    transform: translateY(10px) scaleY(0.8);
    opacity: 0.1;
  }
}

.hologram-text {
  animation: hologram-flicker 3s ease-in-out infinite;
  position: relative;
}

.hologram-text::after {
  content: attr(data-text);
  position: absolute;
  left: 0;
  top: 100%;
  width: 100%;
  color: rgba(0, 255, 255, 0.3);
  animation: mirror-reflect 3s ease-in-out infinite;
  transform: scaleY(-1);
  filter: blur(2px);
}

.liquid-blob {
  animation: liquid-morph 6s ease-in-out infinite;
}